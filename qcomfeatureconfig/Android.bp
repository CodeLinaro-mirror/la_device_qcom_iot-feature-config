soong_config_module_type {
    name: "qcomfeatureconfig_java_library",
    module_type: "java_library",
    config_namespace: "qcomfeatureconfig",
    bool_variables: ["iotlowram","iotscanchannel", "iotbtext"],
    properties: [
        "srcs",
    ],
}

genrule {
    name: "qcomlowramconfig_java_gen",
    srcs: ["QcomLowRamConfigTemplate_java"],
    out: ["QcomLowRamConfig.java"],
    cmd: "echo \"Generating QcomLowRamConfig.java\" && sed 's/__TARGET_QCOM_IOT_LOW_RAM_VALUE__/true/' $(location QcomLowRamConfigTemplate_java) > $(out)",
}


genrule {
    name: "qcomlowramconfig_java_gen_default",
    srcs: ["QcomLowRamConfigTemplate_java"],
    out: ["QcomLowRamConfig.java"],
    cmd: "echo \"Generating default QcomLowRamConfig.java\" && sed 's/__TARGET_QCOM_IOT_LOW_RAM_VALUE__/false/' $(location QcomLowRamConfigTemplate_java) > $(out)",
}

genrule {
    name: "qcomscanchannelconfig_java_gen",
    srcs: ["QcomScanChannelConfigTemplate_java"],
    out: ["QcomScanChannelConfig.java"],
    cmd: "echo \"Generating QcomScanChannelConfig.java\" && sed 's/__TARGET_QCOM_IOT_SCANCHANNEL_VALUE__/true/' $(location QcomScanChannelConfigTemplate_java) > $(out)",
}

genrule {
    name: "qcomscanchannelconfig_java_gen_default",
    srcs: ["QcomScanChannelConfigTemplate_java"],
    out: ["QcomScanChannelConfig.java"],
    cmd: "echo \"Generating default QcomScanChannelConfig.java\" && sed 's/__TARGET_QCOM_IOT_SCANCHANNEL_VALUE__/false/' $(location QcomScanChannelConfigTemplate_java) > $(out)",
}


genrule {
    name: "qcombtextconfig_java_gen",
    srcs: ["QcomBtExtConfigTemplate_java"],
    out: ["QcomBtExtConfig.java"],
    cmd: "echo \"Generating QcomBtExtConfig.java\" && sed 's/__TARGET_QCOM_IOT_BT_EXT_VALUE__/true/' $(location QcomBtExtConfigTemplate_java) > $(out)",
}

genrule {
    name: "qcombtextconfig_java_gen_default",
    srcs: ["QcomBtExtConfigTemplate_java"],
    out: ["QcomBtExtConfig.java"],
    cmd: "echo \"Generating QcomBtExtConfig.java\" && sed 's/__TARGET_QCOM_IOT_BT_EXT_VALUE__/false/' $(location QcomBtExtConfigTemplate_java) > $(out)",
}

qcomfeatureconfig_java_library {
    name: "qcomFeatureConfigLib",
    sdk_version: "module_current",
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "33",
    soong_config_variables: {
        iotlowram: {
            srcs: [":qcomlowramconfig_java_gen"],
            conditions_default:{
                srcs: [":qcomlowramconfig_java_gen_default"],
            },
        },
        iotscanchannel: {
            srcs: [":qcomscanchannelconfig_java_gen"],
            conditions_default:{
                srcs: [":qcomscanchannelconfig_java_gen_default"],
            },
        },
        iotbtext: {
            srcs: [":qcombtextconfig_java_gen"],
            conditions_default: {
                srcs: [":qcombtextconfig_java_gen_default"]
            },
        },
    },
}
